{{ stylesheet_link('css/timeline.css') }}

<main class="main-content">
    <div class ="container">
        <div class="margin-top row">
            <div id= "left-content" class="col-md-9">
                <div class="container">
                    <div class="col-md-9">
                        <h1 id="timeline">Corporate Chronicle</h1>
                        <hr class="colorgraph">
                        <ul class="timeline">
                            <li class="timeline">
                                <div class="timeline-badge info"><i class="fa fa-envelope-o"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">Incorporation of Fareast Islami Properties Ltd</h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> 24 June, 2014</small></p>
                                    </div>
                                </div>
                            </li>
                            <li class="timeline-inverted">
                                <div class="timeline-badge warning"><i class="fa fa-bullseye"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">Authorized capital increased to BDT 1000 million </h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> 5 May, 2013</small></p>
                                    </div>
                                </div>
                            </li>
                            <li class="timeline">
                                <div class="timeline-badge danger"><i class="fa fa-crosshairs"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">Incorporation of Fareast Islami Securities Ltd</h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> 06 June, 2012</small></p>
                                    </div>
                                </div>
                            </li>
                            <li class="timeline-inverted">
                                <div class="timeline-badge success"><i class="fa fa-thumbs-o-down"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">Revaluation of Fareast Tower</h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> 27 December, 2011</small></p>
                                    </div>
                                    <!-- <div class="timeline-body">
                                        <p>Lorem ipsum dolor sit amet</p>
                                    </div> -->
                                </div>
                            </li>
                            <li class="timeline">
                                <div class="timeline-badge info"><i class="fa fa-envelope-o"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">Change the denomination of Face vlaue BDT 10.00</h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> 12 August, 2010</small></p>
                                    </div>
                                </div>
                            </li>
                            <li class="timeline-inverted">
                                <div class="timeline-badge warning"><i class="fa fa-bullseye"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">First observation of Service Month </h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> July, 2006</small></p>
                                    </div>
                                </div>
                            </li>
                            <li class="timeline">
                                <div class="timeline-badge danger"><i class="fa fa-crosshairs"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">Trading of shares on Chittagong Stock Exchange Ltd</h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> 20 July, 2005</small></p>
                                    </div>
                                </div>
                            </li>
                            <li class="timeline-inverted">
                                <div class="timeline-badge success"><i class="fa fa-thumbs-o-down"></i></div>
                                <div class="timeline-panel">
                                    <div class="timeline-heading">
                                        <h5 class="timeline-title">Trading of shares on Dhaka Stock Exchange Ltd</h5>
                                        <p><small class="text-muted"><i class="fa fa-clock-o"></i> 18 July, 2005</small></p>
                                    </div>
                                    <!-- <div class="timeline-body">
                                        <p>Lorem ipsum dolor sit amet</p>
                                    </div> -->
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div><!-- End Left content -->
            <div id= "right-content" class="col-md-3 col-xs-12">
                {{ partial("layouts/partial/weAreSidebar") }}
            </div><!-- End right content -->
        </div>
    </div>
</main>