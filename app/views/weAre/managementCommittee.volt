<main class="main-content">
    <div class ="container">
        <div class="margin-top row">
            <div id= "left-content" class="col-md-9">
                <div class="row margin-bottom">
                    <h1>Management Committee</h1>
                    <hr class="colorgraph">
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/hemayet-ullah.jpg", "alt": "Helayet Ullah") }}
                            </div>
                            <h4>Md. Hemayet Ullah</h4>
                            <span>Cheif Executive Officer</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/KhalequeFCA.jpg", "alt": "Abdul Khaleque") }}
                            </div>
                            <h4> Md. Abdul Khaleque FCA</h4>
                            <span>Addl. Managing Director & CFO</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                </div>  <!-- .row -->
                <div class="row margin-bottom">
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/aziz.jpg", "alt": "Syed Abdul Aziz") }}
                            </div>
                            <h4>Syed Abdul Aziz</h4>
                            <span>DMD & Company Secretary</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/hemayet_HRD.jpg", "alt": "Hemayet Uddin") }}
                            </div>
                            <h4> A K M Hemayet Uddin</h4>
                            <span>DMD & Head of Human Resources</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                </div>  <!-- .row -->
                <div class="row margin-bottom">
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/majedul.jpg", "alt": "Md Majedul Islam") }}
                            </div>
                            <a href="#" id ="profile-majedul" data-toggle="modal" data-target="#modalDirector"> <h4>Md. Majedul Islam</h4> </a>

                            <span>SEVP & Head of IT</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/amir.jpg", "alt": "Amir Mohammed Ibrahim") }}
                            </div>
                            <h4> Amir Mohammed Ibrahim</h4>
                            <span>SEVP & Project Incharge</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                </div>  <!-- .row -->
                <div class="row margin-bottom">
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/Kamal_Howlader.jpg", "alt": "Md Kamal Hosen Hawlader") }}
                            </div>
                            <h4>Md Kamal Hosen Hawlader</h4>

                            <span>JEVP & Head of Internal Control & Complaince</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="director-card">
                            <div class="director-thumb">
                                {{ image("images/management/razzak.jpg", "alt": "Sk Abdul Razzaque") }}
                            </div>
                            <h4> Sk Abdul Razzaque</h4>
                            <span>SVP & Incharge, Banking & Investment</span>
                        </div>
                    </div> <!-- /.col-sm-4 -->
                </div>  <!-- .row -->
            </div><!-- End Left content -->
            <div id= "right-content" class="col-md-3 col-xs-12">
                {{ partial("layouts/partial/weAreSidebar") }}
            </div><!-- End right content -->
        </div>
    </div>
</main>
